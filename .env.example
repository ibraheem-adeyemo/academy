# Neon Postgres connection strings (get these from your Neon project dashboard)
# Pooled connection — used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-example-pooler.neon.tech/neondb?sslmode=require"
# Direct connection — used by Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"

# Random 32+ character string used to encrypt the admin session cookie
SESSION_SECRET=""

# Only used once by `npx prisma db seed` to bootstrap the first admin user
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: forward new applications to a webhook (Slack/Zapier/Make) in addition to storing them
APPLY_FORM_WEBHOOK_URL=""
